# systemd *user* unit (spec §11.1). Install to
#   /usr/lib/systemd/user/            (packages)
#   ~/.config/systemd/user/           (development)
# and enable explicitly during onboarding:
#   systemctl --user enable --now postmoth-daemon.service
[Unit]
Description=Postmoth mail daemon
Documentation=https://github.com/maskedsyntax/postmoth
# Needs the session bus and (lazily) the Secret Service.
After=dbus.socket
Requires=dbus.socket

[Service]
Type=dbus
BusName=dev.postmoth.Daemon1
ExecStart=/usr/bin/postmoth-daemon
Restart=on-failure
RestartSec=5s
Environment=POSTMOTH_LOG=info

# The process holds passwords and one-time codes in memory.
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
